# Real server is the default. Set demo explicitly for the visual prototype.
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://127.0.0.1:18091/api

# Google Maps official JavaScript API key for overview, dashboard and asset map query.
# Set only in .env.local or the deployment environment; do not commit a real key.
VITE_GOOGLE_MAPS_API_KEY=

# Optional MyMemory-compatible translation GET endpoint. Defaults to MyMemory.
# Use a same-origin proxy here for a managed provider; never put secret API keys in VITE_*.
VITE_TRANSLATION_ENDPOINT=

# Local Vite development port.
PORT=8444

# Optional Figma Make / preview settings.
# FIGMA_PUBLIC_URL=
# FIGMA_DEV_SERVER_HOST=0.0.0.0
