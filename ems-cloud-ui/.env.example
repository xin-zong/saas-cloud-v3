# Real server is the default. Set demo explicitly for the visual prototype.
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://127.0.0.1:18090/api

# Optional AMap key used by the overview and query maps.
# This value is injected at build time. Do not commit a real key.
VITE_AMAP_KEY=

# Local Vite development port.
PORT=8443

# Optional Figma Make / preview settings.
# FIGMA_PUBLIC_URL=
# FIGMA_DEV_SERVER_HOST=0.0.0.0
