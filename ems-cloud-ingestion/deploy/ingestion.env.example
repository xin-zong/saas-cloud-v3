# Server-only paths. Copy to /etc/ems-cloud-v3/ingestion.env, root:ems-cloud-v3 0640.
# This file contains no secrets. Use the existing managed database/CH files.
EMS_MQTT_URI=ssl://120.27.23.229:8884
EMS_MQTT_CLIENT_ID=ems-cloud-v3-ingestion
EMS_MQTT_CA=/etc/ems-cloud-v3/client-tls/ca.crt
EMS_MQTT_CERT=/etc/ems-cloud-v3/client-tls/client.crt
EMS_MQTT_KEY=/etc/ems-cloud-v3/client-tls/client.key
EMS_KAFKA_CONFIG=/etc/ems-cloud-v3/kafka-client.properties
EMS_QUEUE_CAPACITY=256
EMS_LEASE_SECONDS=30
EMS_KAFKA_FAST_TOPIC=ems-cloud-v3.ingress.fast.v1
EMS_KAFKA_STATE_TOPIC=ems-cloud-v3.ingress.state.v1
EMS_KAFKA_RELIABLE_TOPIC=ems-cloud-v3.ingress.reliable.v1
EMS_KAFKA_RELIABLE_GROUP=ems-cloud-v3.ingestion.reliable.v1
EMS_KAFKA_TELEMETRY_GROUP=ems-cloud-v3.ingestion.telemetry.v1
