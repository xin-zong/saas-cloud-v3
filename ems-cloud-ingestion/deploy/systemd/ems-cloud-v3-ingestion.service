[Unit]
Description=EMS MQTT Kafka PostgreSQL ClickHouse ingestion worker
After=network-online.target ems-cloud-v3-mqtt.service
Wants=network-online.target
Requires=ems-cloud-v3-mqtt.service

[Service]
Type=simple
User=ems-cloud-v3
Group=ems-cloud-v3
EnvironmentFile=/etc/ems-cloud-v3/database.env
EnvironmentFile=/etc/ems-cloud-v3/clickhouse.env
EnvironmentFile=/etc/ems-cloud-v3/ingestion.env
ExecStart=/opt/ems-cloud-v3/current/deploy/worker-launch.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
